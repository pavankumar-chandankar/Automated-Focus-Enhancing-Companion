# By default, all advice is generated by a deterministic MOCK (not an LLM).
FOCUSBUDDY_LLM_MODE=mock
FOCUSBUDDY_DB_PATH=./var/focusbuddy.sqlite3
FOCUSBUDDY_RETENTION_DAYS=14
# To use a real OpenAI-compatible provider, explicitly set all three:
# FOCUSBUDDY_LLM_MODE=openai_compatible
# FOCUSBUDDY_LLM_BASE_URL=https://api.openai.com/v1
# FOCUSBUDDY_LLM_MODEL=your-approved-model-id
# FOCUSBUDDY_LLM_API_KEY=your_secret_here
# Required for non-local demo deployments:
# FOCUSBUDDY_API_TOKEN=create_a_random_long_secret

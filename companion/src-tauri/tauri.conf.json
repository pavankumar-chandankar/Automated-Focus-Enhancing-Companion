{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oplyra",
  "version": "0.1.0",
  "identifier": "com.pavankumar.oplyra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oplyra Companion",
        "width": 192,
        "height": 210,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "drop-zone",
        "title": "Oplyra Drop Target",
        "url": "index.html#drop-zone",
        "width": 112,
        "height": 112,
        "center": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/icon.ico"
    ]
  }
}
